		dcterms:description "Same as ANALYSIS_YR in all_areas_nuseds" ;
		csvw:title "Analysis year" ;
		csvw:name "Year" ;
		a csvw:Column .
	corpus:dataset\/psf-nuseds-cleaned\/table\/cu_year_spawners csvw:column corpus:dataset\/psf-nuseds-cleaned\/table\/cu_year_spawners\/column\/Year .
