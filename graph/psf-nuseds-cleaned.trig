		<http://qudt.org/schema/qudt/unit> unit:INDIV ;
		csvw:datatype "number" ;
		def:columnRole "measurement" ;
		dcterms:description "Sum of MAX_ESTIMATE over the CU's stream sites with a non-missing estimate of this classification in this year. Not infilled or expanded; NOT the PSE CU-level spawner abundance." ;
		csvw:title "Spawner abundance (sum of stream MAX_ESTIMATE)" ;
		csvw:name "spawner_abundance" ;
		a csvw:Column .
	corpus:dataset\/psf-nuseds-cleaned\/table\/cu_year_spawners csvw:column corpus:dataset\/psf-nuseds-cleaned\/table\/cu_year_spawners\/column\/spawner_abundance .
	corpus:dataset\/psf-nuseds-cleaned\/table\/cu_year_spawners\/column\/ESTIMATE_CLASSIFICATION def:codeList corpus:code\/nuseds\/estimate-classification ;
		def:semanticStatus "partial" ;
		csvw:datatype "string" ;
		def:columnRole "categorical" ;
		dcterms:description "This categorizes estimates based on their levels of accuracy and precision (Type-1 are the most accurate, Type-6 the least accurate). There are three other classifications that belong to SENs whose source data were migrated from the regional MSAccess SILBC16 database (definitions extracted from that user manual).RELATIVE: CONSTANT MULTI-YEAR METHODS andRELATIVE: VARYING MULTI-YEAR METHODS: 'This is the case with survey methods restricted to a fraction of the spawning habitat and/or a fraction of the spawning period. There are various types of relative abundance estimates depending on the survey method, the level of standardization of the methods, and the sampling effort.  For our purpose we have retained one type based on between-year consistency of the method where there are two levels.'NO SURVEY THIS YEAR: 'stream was not inspected for that species this year'" ;
		csvw:title "Estimate classification" ;
		csvw:name "ESTIMATE_CLASSIFICATION" ;
		a csvw:Column .
	corpus:dataset\/psf-nuseds-cleaned\/table\/cu_year_spawners csvw:column corpus:dataset\/psf-nuseds-cleaned\/table\/cu_year_spawners\/column\/ESTIMATE_CLASSIFICATION .
