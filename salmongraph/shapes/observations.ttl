@prefix shape: <urn:salmongraph:shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix smn: <https://w3id.org/smn/> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Required semantic slots can instead be valid pending candidates on original
# quads. The Python gate checks completeness without adding shadow statements.
shape:Observation a sh:NodeShape ; sh:targetClass qb:Observation, sosa:Observation ;
    sh:nodeKind sh:IRI ;
    sh:property shape:Dataset, shape:ObservedColumn, shape:Result,
                shape:LiveUnit, shape:BroodYear, shape:ReturnYear,
                shape:Procedure, shape:StandardUncertainty .
shape:Dataset a sh:PropertyShape ; sh:path qb:dataSet ;
    sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI .
shape:ObservedColumn a sh:PropertyShape ; sh:path sosa:observedProperty ;
    sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
    sh:class csvw:Column ; sh:class qb:MeasureProperty .
shape:MeasureColumn a sh:NodeShape ; sh:targetObjectsOf sosa:observedProperty ;
    sh:property shape:LiveConcept, shape:LiveUnit, shape:Procedure .
shape:LiveConcept a sh:PropertyShape ; sh:path qb:concept ; sh:maxCount 1 ; sh:nodeKind sh:IRI .
shape:Result a sh:PropertyShape ; sh:path sosa:hasSimpleResult ;
    sh:minCount 1 ; sh:maxCount 1 ; sh:node shape:Numeric .
shape:LiveUnit a sh:PropertyShape ; sh:path qudt:unit ; sh:maxCount 1 ; sh:nodeKind sh:IRI .
shape:BroodYear a sh:PropertyShape ; sh:path smn:broodYear ; sh:maxCount 1 ; sh:datatype xsd:gYear .
shape:ReturnYear a sh:PropertyShape ; sh:path smn:returnYear ; sh:maxCount 1 ; sh:datatype xsd:gYear .
shape:Procedure a sh:PropertyShape ; sh:path sosa:usedProcedure ; sh:maxCount 1 ; sh:nodeKind sh:IRI .
shape:StandardUncertainty a sh:PropertyShape ; sh:path qudt:standardUncertainty ;
    sh:maxCount 1 ; sh:node shape:Numeric ; sh:minInclusive 0 .
shape:Numeric a sh:NodeShape ; sh:or (
    [ sh:datatype xsd:decimal ] [ sh:datatype xsd:float ] [ sh:datatype xsd:double ]
    [ sh:datatype xsd:integer ] [ sh:datatype xsd:int ] [ sh:datatype xsd:long ]
    [ sh:datatype xsd:short ] [ sh:datatype xsd:byte ]
    [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:positiveInteger ]
    [ sh:datatype xsd:nonPositiveInteger ] [ sh:datatype xsd:negativeInteger ]
    [ sh:datatype xsd:unsignedLong ] [ sh:datatype xsd:unsignedInt ]
    [ sh:datatype xsd:unsignedShort ] [ sh:datatype xsd:unsignedByte ]
) .
