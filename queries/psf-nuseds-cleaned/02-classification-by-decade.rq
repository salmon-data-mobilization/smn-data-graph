# CQ2: How did estimate classifications change over time?
# Stream-level estimates per decade by gcdfo estimate type, resolved through the SSSOM-derived
# mappings graph (NuSEDS code -> gcdfo concept). Unmapped codes are shown by their NuSEDS label.
PREFIX qb: <http://purl.org/linked-data/cube#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX csvw: <http://www.w3.org/ns/csvw#>
PREFIX smn: <https://w3id.org/smn/>
PREFIX gcdfo: <https://w3id.org/gcdfo/salmon#>
PREFIX def: <https://w3id.org/salmon-demo-corpus/def/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?decade ?estimate_type (SUM(?n) AS ?site_estimates)
WHERE {
  ?obs def:estimateClassification ?code ; smn:returnYear ?y ; def:siteCount ?n .
  ?code skos:prefLabel ?code_label .
  OPTIONAL { ?code skos:exactMatch|skos:broadMatch ?t . ?t skos:prefLabel ?t_label . }
  BIND(COALESCE(STR(?t_label), CONCAT("unmapped NuSEDS: ", STR(?code_label))) AS ?estimate_type)
  BIND(FLOOR(xsd:integer(STR(?y)) / 10) * 10 AS ?decade)
}
GROUP BY ?decade ?estimate_type
ORDER BY ?decade DESC(?site_estimates)
