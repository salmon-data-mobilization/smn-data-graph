# CQ5: How many CUs and stream sites have any spawner estimate each year (1980-2024)?
PREFIX qb: <http://purl.org/linked-data/cube#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX csvw: <http://www.w3.org/ns/csvw#>
PREFIX smn: <https://w3id.org/smn/>
PREFIX gcdfo: <https://w3id.org/gcdfo/salmon#>
PREFIX def: <https://w3id.org/salmon-demo-corpus/def/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?year (COUNT(DISTINCT ?cu) AS ?cus_with_estimate) (SUM(?n) AS ?stream_estimates)
WHERE {
  ?obs def:conservationUnit ?cu ; smn:returnYear ?y ; def:siteCount ?n .
  BIND(xsd:integer(STR(?y)) AS ?year)
  FILTER(?year >= 1980)
}
GROUP BY ?year ORDER BY ?year
