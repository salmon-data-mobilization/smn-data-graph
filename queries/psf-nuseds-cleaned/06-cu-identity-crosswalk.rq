# CQ6: Where do PSF (PSE) Conservation Units differ from DFO CUs? (identity nodes; joins to DFO datasets)
PREFIX qb: <http://purl.org/linked-data/cube#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX csvw: <http://www.w3.org/ns/csvw#>
PREFIX smn: <https://w3id.org/smn/>
PREFIX gcdfo: <https://w3id.org/gcdfo/salmon#>
PREFIX def: <https://w3id.org/salmon-demo-corpus/def/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?dfo_cu_index (COUNT(DISTINCT ?cu) AS ?psf_cus) (GROUP_CONCAT(DISTINCT ?psf_label; separator=" | ") AS ?psf_cu_names)
WHERE {
  ?cu skos:broadMatch ?dfo ; skos:prefLabel ?psf_label .
  ?dfo skos:notation ?dfo_cu_index .
}
GROUP BY ?dfo_cu_index ORDER BY ?dfo_cu_index
