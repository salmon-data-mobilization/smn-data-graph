# CQ3: Classification-coverage screen for PSF source CU groupings (2015 onward).
# Retains the original >=10 records and >=50% combined screen, but separates
# Type-5/6 from unresolved classifications. Unmapped/pending metadata is not
# evidence of poor biological data quality. Counts are source MAX_ESTIMATE records.
PREFIX qb: <http://purl.org/linked-data/cube#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX csvw: <http://www.w3.org/ns/csvw#>
PREFIX smn: <https://w3id.org/smn/>
PREFIX gcdfo: <https://w3id.org/gcdfo/salmon#>
PREFIX def: <https://w3id.org/salmon-demo-corpus/def/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX profile: <https://w3id.org/salmon-demo-corpus/profile/>

SELECT ?region_label ?species ?cu_label ?cu_index
       (SUM(?n) AS ?site_estimates) (SUM(?type56) AS ?type5_6_estimates)
       (SUM(?unresolved) AS ?unresolved_classification_estimates)
       (ROUND(100 * SUM(?type56) / SUM(?n)) AS ?pct_type5_6)
       (ROUND(100 * SUM(?unresolved) / SUM(?n)) AS ?pct_unresolved_classification)
WHERE {
  ?obs def:conservationUnit ?cu ; def:estimateClassification ?code ; smn:returnYear ?y ; def:siteCount ?n .
  FILTER(xsd:integer(STR(?y)) >= 2015)
  ?cu skos:prefLabel ?cu_label ; def:pseCuIndex ?cu_index ; def:region/skos:prefLabel ?region_label ; def:taxon/rdfs:label ?species .
  BIND(EXISTS { ?code skos:exactMatch ?t14 . FILTER(?t14 IN (gcdfo:Type1, gcdfo:Type2, gcdfo:Type3, gcdfo:Type4)) } AS ?has_type14)
  BIND(EXISTS { ?code skos:exactMatch ?t56 . FILTER(?t56 IN (gcdfo:Type5, gcdfo:Type6)) } AS ?has_type56)
  BIND(IF(?has_type56, ?n, 0) AS ?type56)
  BIND(IF(!?has_type14 && !?has_type56, ?n, 0) AS ?unresolved)
}
GROUP BY ?region_label ?species ?cu_label ?cu_index
HAVING (SUM(?n) >= 10 && (SUM(?type56) + SUM(?unresolved)) / SUM(?n) >= 0.5)
ORDER BY DESC(?pct_type5_6) DESC(?pct_unresolved_classification) DESC(?site_estimates) ?cu_index
